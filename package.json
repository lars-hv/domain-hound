{
  "name": "domain-hound",
  "version": "0.1.21",
  "description": "Ask Claude or ChatGPT for a name or domain. Get one you can buy. It checks the domain, the cheapest shop including renewal, the app stores and US trademarks, in one answer. Free. Never buys without your yes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "domain-hound": "dist/domain-hound.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://domainhound.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lars-hv/domain-hound.git"
  },
  "keywords": [
    "domain name",
    "domain availability",
    "domain prices",
    "renewal price",
    "startup name",
    "business name",
    "naming",
    "app name",
    "trademark",
    "rebrand",
    ".com",
    ".ai"
  ],
  "mcpName": "dev.domainhound/domain-hound",
  "files": [
    "dist/domain-hound.mjs",
    "dist/THIRD-PARTY-NOTICES.txt",
    "assets/icon-512.png",
    "assets/icon-1024.png",
    "skills/domain-hound/SKILL.md",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json",
    "plugin.json",
    "mcp.json",
    "server.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test package.test.mjs server.test.mjs results.test.mjs share.test.mjs dossier.test.mjs clis/domain-check/*.test.mjs clis/domain-check/test.mjs clis/spaceship/*.test.mjs clis/portfolio/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "snapshot-prices": "node scripts/snapshot-prices.mjs",
    "build-mcpb": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "parse5": "^7.3.0"
  },
  "bugs": {
    "url": "https://github.com/lars-hv/domain-hound/issues"
  }
}
