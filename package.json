{
  "name": "domain-hound",
  "version": "0.1.4",
  "description": "Check domains, compare registrar prices, and screen product names from your MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "domain-hound": "bin/domain-hound.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://domainhound.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lars-hv/domain-hound.git"
  },
  "keywords": [
    "mcp",
    "domains",
    "claude",
    "codex"
  ],
  "mcpName": "dev.domainhound/domain-hound",
  "files": [
    "bin/domain-hound.mjs",
    "server.mjs",
    "display.mjs",
    "results.mjs",
    "results-style.mjs",
    "watch.mjs",
    "clis/domain-check/cache.mjs",
    "clis/domain-check/com-site.mjs",
    "clis/domain-check/company-search.mjs",
    "clis/domain-check/confirm.mjs",
    "clis/domain-check/google-play.mjs",
    "clis/domain-check/google-search.mjs",
    "clis/domain-check/index.mjs",
    "clis/domain-check/name-search.mjs",
    "clis/domain-check/naming-method.mjs",
    "clis/domain-check/parking.mjs",
    "clis/domain-check/price-catalog.mjs",
    "clis/domain-check/price-snapshot.json",
    "clis/domain-check/prices.mjs",
    "clis/domain-check/progress.mjs",
    "clis/domain-check/registry.mjs",
    "clis/domain-check/terms.json",
    "clis/domain-check/traction.mjs",
    "clis/domain-check/triage-sources.mjs",
    "clis/domain-check/triage.mjs",
    "assets/",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json",
    "plugin.json",
    "mcp.json",
    "server.json"
  ],
  "scripts": {
    "test": "node --test server.test.mjs results.test.mjs clis/domain-check/*.test.mjs clis/domain-check/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "snapshot-prices": "node scripts/snapshot-prices.mjs",
    "build-mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "parse5": "^7.3.0"
  },
  "bugs": {
    "url": "https://github.com/lars-hv/domain-hound/issues"
  }
}
